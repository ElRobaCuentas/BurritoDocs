{
  "rules": {
    "ubicacion_burrito": {
      ".read": true
    },
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "comentarios": {
      ".read": false,
      ".write": "auth != null"
    },
    "administradores": {
      ".read": "auth != null",
      ".write": false
    },
    "asignaciones": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()",
      ".indexOn": ["choferId"]
    },
    "ubicacion_buses": {
      ".read": true,
      ".write": "auth != null"
    },
    "choferes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()"
    },
    "buses": {
      ".read": "auth != null && root.child('administradores').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()"
    }
  }
}
