{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "comentarios": { ".read": false, ".write": "auth != null" },
    "administradores": { ".read": "auth != null", ".write": "auth != null && root.child('administradores').child(auth.uid).exists()" },
    "asignaciones": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()",
      ".indexOn": ["choferId"]
    },
    "ubicacion_buses": {
      ".read": true,
      ".write": "auth != null && (root.child('administradores').child(auth.uid).exists() || root.child('choferes_uids').child(auth.uid).exists())"
    },
    "choferes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()"
    },
    "choferes_uids": {
      ".read": false,
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()"
    },
    "buses": {
      ".read": "auth != null && root.child('administradores').child(auth.uid).exists()",
      ".write": "auth != null && root.child('administradores').child(auth.uid).exists()"
    }
  }
}
